# === Telegram Escrow Marketplace Bot — configuration ===
# Copy this file to .env and fill in the values. NEVER commit .env.

# 1) Bot token from @BotFather on Telegram (looks like 123456789:AAH...)
BOT_TOKEN=

# 2) Your Telegram numeric user ID(s), comma separated. Get it from @userinfobot.
#    These users get the in-bot ADMIN PANEL.
ADMIN_IDS=

# 3) Encryption key for the credential vault. Generate one with:
#    python -m bot.utils.vault genkey
#    Paste the output here. NEVER reuse across installs, NEVER commit.
FERNET_KEY=

# 4) Differentiated commission per payment method (flat, completed deals only).
#    USDT deals (Binance/Bybit): deducted in USDT cents. 200 = $2.00
#    Local deals (Easypaisa/JazzCash/bank): deducted in PKR.
COMMISSION_USDT_CENTS=200
COMMISSION_LOCAL_PKR=50

# 4b) USD -> PKR conversion rate for local payment methods (admin-configurable).
USD_PKR_RATE=280

# 4c) Listing auto-approve: "true" = new listings go LIVE immediately
#    (flagged ones still notify the admin); "false" = admin must approve.
AUTO_APPROVE_LISTINGS=true

# 5) Business timers (hours). Locked spec values: 24 / 8 / 12.
HOLD_HOURS=24
HANDOVER_HOURS=8
DELIVERY_DEADLINE_HOURS=12

# 5b) Enabled payment methods (comma-separated; valid: binance, bybit, manual).
#     Only these appear as buyer choices. Example: PAY_METHODS=binance,manual
PAY_METHODS=binance,manual

# 6) Binance auto-verify via deposit polling (READ-ONLY keys — never enable
#    withdrawal/trading permission). When the keys + address below are set,
#    buyers paying via Binance get auto-detected deposits; otherwise the bot
#    falls back to manual Pay-ID confirmation. No merchant approval needed.
#    (Legacy BINANCE_MODE is still accepted but no longer gates anything.)
BINANCE_MODE=manual
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_USDT_ADDRESS=
BINANCE_NETWORK=TRC20

# 6b) Bybit auto-verify via deposit polling (same read-only rules as above).
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_USDT_ADDRESS=

# 6c) Auto-verify polling tuning.
PAYMENT_POLL_INTERVAL_SEC=60
PAYMENT_POLL_TIMEOUT_MIN=30
PAYMENT_AMOUNT_TOLERANCE=0.5

# 7) Escrow receiving addresses — where BUYERS send money.
#    Shown to buyers at payment time. Leave empty only for local testing.
ESCROW_BINANCE_ADDRESS=
ESCROW_MANUAL_NUMBER=
ESCROW_MANUAL_TITLE=Escrow

# 8) Database file (SQLite). Back this file up regularly.
DATABASE_PATH=./data/escrow.db

# 8) Webhook (production). Leave empty to use long-polling (local testing).
WEBHOOK_URL=
PORT=8000

# 9) Rating window in days after a deal completes.
RATING_WINDOW_DAYS=7
